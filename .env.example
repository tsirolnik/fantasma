# LLM Configuration
LLM_PROVIDER=claude          # claude or ollama
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-20250514
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Platform API Keys (optional - enhances discovery)
HACKERONE_API_TOKEN=
HACKERONE_API_USERNAME=
BUGCROWD_API_TOKEN=
INTIGRITI_API_TOKEN=

# Scanning Configuration
RATE_LIMIT_RPS=2             # Requests per second per domain
MAX_CONCURRENCY=10           # Max concurrent scan tasks
SCAN_TIMEOUT=30              # HTTP request timeout in seconds

# Cost Configuration
HOURLY_RATE=50               # Your hourly rate in USD for effort cost
INFRA_HOURLY_COST=0.10       # Cloud/VPS hourly cost in USD
SESSION_BUDGET=100           # Max budget per session in USD

# Director/Worker Agent System
DIRECTOR_LLM_PROVIDER=claude   # LLM provider for the Director agent
DIRECTOR_LLM_MODEL=            # Model override for Director (empty = provider default)
WORKER_LLM_PROVIDER=ollama     # Default LLM provider for worker agents
WORKER_LLM_MODEL=              # Model override for workers (empty = provider default)
AUTO_MODE=false                # Run fully unattended (no human checkpoints)
PAUSE_POINTS=                  # Comma-separated phases to pause at (e.g. discover,analyze)

# Output
OUTPUT_DIR=./output
VERBOSE=false

# OpenAI-compatible endpoints: prices are USD per million tokens.
# Required when this provider is selected; replace examples with actual rates.
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_INPUT_PRICE=1.0
# OPENAI_OUTPUT_PRICE=3.0
# Explicit opt-in for a genuinely free/self-hosted endpoint only:
OPENAI_FREE_ENDPOINT=false

# Dashboard: empty generates a fresh token printed in the server terminal.
# Enter it on the dashboard login page. External ingest clients use Bearer auth.
WEB_AUTH_TOKEN=
WEB_HOST=127.0.0.1
