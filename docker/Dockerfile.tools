FROM golang:1.23-bookworm AS go-builder

# Install Go-based security tools with pinned versions
RUN go install github.com/projectdiscovery/katana/cmd/katana@v1.1.0 && \
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.3.7 && \
    go install github.com/projectdiscovery/httpx/cmd/httpx@v1.6.9 && \
    go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.6.7 && \
    go install github.com/ffuf/ffuf/v2@v2.1.0 && \
    go install github.com/lc/gau/v2/cmd/gau@v2.2.4 && \
    go install github.com/hahwul/dalfox/v2@v2.9.3 && \
    go install github.com/owasp-amass/amass/v4/...@v4.2.0

# Trufflehog requires clone+build due to replace directives in go.mod
RUN git clone --depth 1 --branch v3.88.0 https://github.com/trufflesecurity/trufflehog.git /tmp/trufflehog && \
    cd /tmp/trufflehog && go build -o /go/bin/trufflehog . && \
    rm -rf /tmp/trufflehog

# Betterleaks requires Go 1.25+
FROM golang:1.25-bookworm AS betterleaks-builder
RUN go install github.com/betterleaks/betterleaks@latest

FROM ubuntu:24.04

# System security tools + Python/Ruby for pip/gem tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    dnsutils \
    whois \
    curl \
    wget \
    openssl \
    nikto \
    sqlmap \
    jq \
    ca-certificates \
    python3 \
    python3-pip \
    ruby \
    ruby-dev \
    build-essential \
    libcurl4-openssl-dev \
    zlib1g-dev \
    && gem install wpscan --no-document \
    && pip3 install --break-system-packages \
       commix arjun boto3 awscli \
       requests httpx beautifulsoup4 lxml \
       pyjwt cryptography pycryptodome \
       paramiko dnspython \
       xmltodict pyyaml \
       websockets aiohttp \
       faker \
    && apt-get purge -y build-essential ruby-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip

# Copy Go-built tools from builder
COPY --from=go-builder /go/bin/katana /usr/local/bin/
COPY --from=go-builder /go/bin/nuclei /usr/local/bin/
COPY --from=go-builder /go/bin/httpx /usr/local/bin/
COPY --from=go-builder /go/bin/subfinder /usr/local/bin/
COPY --from=go-builder /go/bin/ffuf /usr/local/bin/
COPY --from=go-builder /go/bin/gau /usr/local/bin/
COPY --from=go-builder /go/bin/dalfox /usr/local/bin/
COPY --from=go-builder /go/bin/amass /usr/local/bin/
COPY --from=go-builder /go/bin/trufflehog /usr/local/bin/
COPY --from=betterleaks-builder /go/bin/betterleaks /usr/local/bin/

# Bake nuclei templates into the image
RUN nuclei -update-templates 2>/dev/null || true

# Wordlists for ffuf/dirbusting
RUN mkdir -p /usr/share/wordlists/dirb && \
    curl -sSL -o /usr/share/wordlists/dirb/common.txt \
      https://raw.githubusercontent.com/v0re/dirb/master/wordlists/common.txt 2>/dev/null || true

WORKDIR /work
ENTRYPOINT ["/bin/bash", "-c"]
